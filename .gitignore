# Unanchored on purpose, unlike the rules below: crates/repo-graph is its own
# Cargo workspace, so building it directly drops a target/ beside its manifest.
target/
# Local cargo path overrides resolving the mere siblings to the working
# copy instead of a pinned rev. Local-dev only, same rule mere carries.
.cargo/
/.tmp/
/.receipts/
/node_modules/
/html/
/.env
/.env.*
!/.env.example
*.local.toml
Thumbs.db
.DS_Store
# No Cargo.lock is tracked (engine split D139); what cargo resolved rides on each
# commit as a git note: `house resolved show <commit>`.
Cargo.lock
